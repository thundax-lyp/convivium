{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "declaration": true,
        "emitDeclarationOnly": true,
        "declarationDir": "lib/types",
        "outDir": "lib",
        "rootDir": "src",
        "paths": {
            "@/*": ["./src/*"],
            "@convivium/dsh-plugin/protocol-types": ["./src/protocol/types.ts"],
            "@convivium/dsh-plugin/remote-types": ["./src/remote/types.ts"]
        },
        "types": ["node"],
        "strict": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/client/**", "tests/**"]
}
