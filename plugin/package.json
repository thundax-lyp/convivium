{
    "name": "@convivium/dsh-plugin",
    "version": "0.0.0",
    "description": "DSH plugin for continuous, structured multi-agent meetings",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/index.js"
        },
        "./client": {
            "types": "./lib/types/client/index.d.ts",
            "default": "./lib/client.js"
        },
        "./typert": {
            "types": "./lib/typert.host.d.ts",
            "default": "./lib/typert.host.js"
        },
        "./remote": {
            "types": "./lib/typert.remote-client.d.ts",
            "default": "./lib/typert.remote-client.js"
        },
        "./remote-types": {
            "types": "./lib/types/remote/types.d.ts",
            "default": "./lib/remote/types.js"
        },
        "./protocol-types": {
            "types": "./lib/types/protocol/types.d.ts",
            "default": "./lib/protocol/types.js"
        },
        "./cordis.patch.yml": "./cordis.patch.yml",
        "./package.json": "./package.json",
        "./meeting-roles/cordis.patch.yml": "./meeting-roles/cordis.patch.yml"
    },
    "files": [
        "lib",
        "cordis.patch.yml",
        "meeting-roles",
        "lib/typert.host.js",
        "lib/typert.host.d.ts",
        "lib/typert.remote-client.js",
        "lib/typert.remote-client.d.ts"
    ],
    "engines": {
        "node": "^22.19.0 || >=24.11.0"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "inject": [
                "@deepseek-ai/dsh-client-ui-renderer",
                "@deepseek-ai/dsh-client-ui-conversation"
            ]
        }
    },
    "scripts": {
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "build": "rm -rf lib && pnpm generate:typert && tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsc-alias -p tsconfig.json && tsdown --config tsdown.config.ts",
        "typecheck:host": "tsc -p tsconfig.json --noEmit",
        "typecheck:client": "pnpm generate:typert && tsc -p tsconfig.client.json --noEmit",
        "typecheck": "pnpm typecheck:host && pnpm typecheck:client",
        "test": "pnpm generate:typert && vitest run",
        "test:integration": "pnpm generate:typert && vitest run --project integration",
        "test:recovery": "pnpm generate:typert && vitest run --project recovery",
        "test:stress": "vitest run tests/stress --passWithNoTests && node -e \"console.log('Not Covered: stress tests')\"",
        "smoke:profile": "node scripts/smoke-profile/index.mjs",
        "verify:agent-definitions": "node scripts/verify-agent-definition-samples.mjs",
        "verify:environment": "node scripts/verify-dsh-environment.mjs",
        "verify:contract": "node scripts/verify-plugin-contract.mjs",
        "verify:package": "node scripts/verify-package.mjs",
        "generate:typert": "node scripts/generate-typert.mjs",
        "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:environment && pnpm verify:contract && pnpm verify:agent-definitions && pnpm verify:package",
        "verify:runtime": "pnpm verify && pnpm smoke:profile"
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "4.0.2",
        "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
        "@deepseek-ai/dsh-agent-presets": "0.1.2-rc.1",
        "@deepseek-ai/dsh-api-gateway": "0.1.2-rc.1",
        "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-rc.1",
        "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
        "@deepseek-ai/dsh-typert-protocol": "0.1.2-rc.1",
        "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
        "@deepseek-ai/dsh-session": "0.1.2-rc.1",
        "@deepseek-ai/dsh-skill": "0.1.2-rc.1",
        "@deepseek-ai/dsh-storage-domain": "0.1.2-rc.1",
        "@deepseek-ai/dsh-subagent": "0.1.2-rc.1",
        "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
        "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
        "@deepseek-ai/dsh-workspace": "0.1.2-rc.1",
        "react": "^18.0.0",
        "react-dom": "^18.0.0"
    },
    "peerDependenciesMeta": {
        "@deepseek-ai/dsh-api-gateway": {
            "optional": true
        },
        "@deepseek-ai/dsh-typert-protocol": {
            "optional": true
        },
        "@deepseek-ai/cordis": {
            "optional": true
        },
        "@deepseek-ai/dsh-agent": {
            "optional": true
        },
        "@deepseek-ai/dsh-storage-domain": {
            "optional": true
        },
        "@deepseek-ai/dsh-session": {
            "optional": true
        },
        "@deepseek-ai/dsh-subagent": {
            "optional": true
        },
        "@deepseek-ai/dsh-system-prompt": {
            "optional": true
        },
        "@deepseek-ai/dsh-tools": {
            "optional": true
        },
        "@deepseek-ai/dsh-workspace": {
            "optional": true
        },
        "@deepseek-ai/dsh-host-webserver": {
            "optional": true
        },
        "@deepseek-ai/dsh-client-ui-renderer": {
            "optional": true
        },
        "@deepseek-ai/dsh-client-ui-conversation": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "@deepseek-ai/dsh-agent-presets": {
            "optional": true
        },
        "@deepseek-ai/dsh-skill": {
            "optional": true
        }
    },
    "dependencies": {
        "@deepseek-ai/schemastery": "3.18.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@deepseek-ai/cordis": "4.0.2",
        "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
        "@deepseek-ai/dsh-agent-presets": "0.1.2-rc.1",
        "@deepseek-ai/dsh-api-gateway": "0.1.2-rc.1",
        "@deepseek-ai/dsh-client-connection": "0.1.2-rc.1",
        "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
        "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-rc.1",
        "@deepseek-ai/dsh-client-ui-layout": "0.1.2-rc.1",
        "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
        "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
        "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
        "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
        "@deepseek-ai/dsh-session": "0.1.2-rc.1",
        "@deepseek-ai/dsh-skill": "0.1.2-rc.1",
        "@deepseek-ai/dsh-storage": "0.1.2-rc.1",
        "@deepseek-ai/dsh-storage-domain": "0.1.2-rc.1",
        "@deepseek-ai/dsh-storage-sqlite": "0.1.2-rc.1",
        "@deepseek-ai/dsh-subagent": "0.1.2-rc.1",
        "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
        "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
        "@deepseek-ai/dsh-typert-generator": "0.1.2-rc.1",
        "@deepseek-ai/dsh-typert-protocol": "0.1.2-rc.1",
        "@deepseek-ai/dsh-typert-registry": "0.1.2-rc.1",
        "@deepseek-ai/dsh-util-values": "0.1.2-rc.1",
        "@deepseek-ai/dsh-workspace": "0.1.2-rc.1",
        "@deepseek-ai/schemastery": "3.18.2",
        "@eslint/js": "10.0.1",
        "@testing-library/react": "^16.2.0",
        "@types/node": "22.20.1",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "eslint": "10.6.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.7.0",
        "jsdom": "29.1.1",
        "prettier": "3.9.3",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "tsc-alias": "^1.8.16",
        "tsdown": "^0.22.14",
        "typescript": "6.0.3",
        "typescript-eslint": "8.62.0",
        "vitest": "4.1.8"
    },
    "packageManager": "pnpm@10.7.0"
}
